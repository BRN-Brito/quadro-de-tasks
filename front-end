<!DOCTYPE html>
<html>
<head>
  <style>
    * { box-sizing: border-box; font-family: 'Segoe UI', system-ui, Arial, sans-serif; }
    body { margin: 15px; background-color: #f0f2f5; color: #333; font-size: 11px; }
    
    .card { background: #ffffff; border-radius: 6px; box-shadow: 0 1px 4px rgba(0,0,0,0.05); border: 1px solid #e4e7eb; padding: 15px; margin-bottom: 15px; }
    .card-title { font-size: 14px; font-weight: 600; color: #1a1c29; margin-top: 0; margin-bottom: 12px; }

    .form-grid { display: grid; grid-template-columns: 110px 110px 110px 110px 1fr; gap: 10px 15px; align-items: start; }
    .item-divisao { grid-column: 1; grid-row: 1; }
    .item-marca { grid-column: 2; grid-row: 1; }
    .item-campanha { grid-column: 3; grid-row: 1; }
    .item-tipo { grid-column: 4; grid-row: 1; }
    .item-link { grid-column: 5; grid-row: 1; }
    .item-obs { grid-column: 1 / 6; grid-row: 2; } 

    .input-group { display: flex; flex-direction: column; gap: 4px; }
    .input-group label { font-size: 10.5px; font-weight: 600; color: #4b5563; }
    .input-group input, .input-group select, .input-group textarea { border: 1px solid #d1d5db; border-radius: 4px; padding: 4px 8px; font-size: 11px; outline: none; background: #fff; width: 100%; height: 26px; transition: border-color 0.2s, box-shadow 0.2s; }
    .input-group input:focus, .input-group select:focus, .input-group textarea:focus { border-color: #2c2f54; box-shadow: 0 0 0 2px rgba(44, 47, 84, 0.1); }
    .item-obs textarea { height: 40px; resize: none; padding: 6px 8px; font-family: inherit;}
    .char-counter { text-align: right; font-size: 9.5px; color: #6b7280; margin-top: 2px; }

    .btn-container { text-align: right; margin-top: 10px; border-top: 1px solid #f3f4f6; padding-top: 10px;}
    .btn { padding: 6px 14px; border: none; border-radius: 4px; font-size: 11px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; }
    .btn:hover { opacity: 0.9; }
    .btn:disabled { opacity: 0.6; cursor: not-allowed; }
    
    .btn-primario { background-color: #2c2f54; color: white; }
    .btn-sucesso { background-color: #10b981; color: white; }
    .btn-cancelar { background-color: #ef4444; color: white; }

    .table-responsive { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; text-align: left; font-size: 11px; }
    th { padding: 10px 8px; font-weight: 600; color: #4b5563; border-bottom: 2px solid #e5e7eb; white-space: nowrap; }
    td { padding: 10px 8px; color: #1f2937; border-bottom: 1px solid #f3f4f6; vertical-align: middle; }
    tbody tr:nth-child(even) { background-color: #f9fafb; }
    tbody tr:hover { background-color: #f3f4f6; }
    .td-curta { max-width: 80px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

    .linha-oculta { display: none; }
    .btn-expandir-historico { cursor: pointer; color: #2c2f54; font-weight: bold; background-color: #f3f4f6; text-align: center; }
    .btn-expandir-historico:hover { background-color: #e5e7eb; }

    .badge { padding: 4px 8px; border-radius: 10px; font-size: 10px; font-weight: 600; display: inline-block; text-align: center; min-width: 75px; }
    .badge-nao-iniciado { background-color: #ef4444; color: white; } 
    .badge-fazendo { background-color: #eab308; color: white; } 
    .badge-aguardando { background-color: #f97316; color: white; } 
    .badge-briefing { background-color: #3b82f6; color: white; } 
    .badge-cancelado { background-color: #a855f7; color: white; } 
    .badge-concluido { background-color: #10b981; color: white; } 

    .acoes-container { display: flex; align-items: center; gap: 10px; }
    .icon-action { cursor: pointer; color: #4b5563; display: flex; align-items: center; }
    .icon-action:hover { color: #111827; }
    .icon-action svg { width: 14px; height: 14px; }
    
    .btn-link-tabela { background-color: #f3f4f6; border: 1px solid #d1d5db; border-radius: 4px; padding: 4px 6px; font-size: 10.5px; color: #374151; font-weight: 600; text-decoration: none; display: inline-flex; align-items: center; gap: 4px; }
    .btn-link-tabela:hover { background-color: #e5e7eb; text-decoration: none; }
    .btn-link-disabled { opacity: 0.4; cursor: not-allowed; pointer-events: none; }

    .fundo-escuro { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0,0,0,0.5); z-index: 1000; backdrop-filter: blur(2px); }
    .janela-modal { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); background: white; padding: 20px 25px; border-radius: 8px; width: 95%; max-width: 650px; max-height: 90vh; overflow-y: auto; box-shadow: 0 10px 25px rgba(0,0,0,0.2); }
    .janela-modal h3 { margin-top: 0; border-bottom: 1px solid #e5e7eb; padding-bottom: 10px; margin-bottom: 12px; font-size: 14px; color: #111827;}
    .modal-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px 15px; }
    .modal-col-full { grid-column: span 3; } 
    .campo-leitura { background-color: #f3f4f6 !important; color: #6b7280 !important; cursor: not-allowed; }
  </style>
</head>
<body>

  <div class="card">
    <h3 class="card-title">Nova Demanda</h3>
    <div class="form-grid">
      <div class="input-group item-divisao">
        <label>Divisão</label>
        <select id="novo_divisao">
          <option value=""></option><option value="DL">DL</option><option value="DPGP">DPGP</option><option value="DPP">DPP</option><option value="LBD">LBD</option><option value="CORP">CORP</option>
        </select>
      </div>
      <div class="input-group item-marca">
        <label>Marca</label><input type="text" id="novo_marca">
      </div>
      <div class="input-group item-campanha">
        <label>Campanha</label><input type="text" id="novo_campanha">
      </div>
      <div class="input-group item-tipo">
        <label>Tipo de Demanda</label>
        <select id="novo_tipoDemanda">
          <option value=""></option><option value="Atualizar PM">Atualizar PM</option><option value="Atualizar base">Atualizar base</option><option value="Ajuste Dash">Ajuste Dash</option><option value="Ajuste PV">Ajuste PV</option><option value="Automatização">Automatização</option><option value="Novo PM">Novo PM</option><option value="RM - add dicionario">RM - add dicionario</option><option value="RM dando erro">RM dando erro</option>
        </select>
      </div>
      <div class="input-group item-link">
        <label>Link</label><input type="text" id="novo_link" placeholder="Link">
      </div>
      <div class="input-group item-obs">
        <label>Observação</label>
        <textarea id="novo_observacao" maxlength="300" onkeyup="atualizarContador()" placeholder="Insira os detalhes iniciais..."></textarea>
        <div class="char-counter" id="charCount">0/300</div>
      </div>
    </div>
    <div class="btn-container">
      <button class="btn btn-primario" onclick="criarSolicitacao()" id="btnCriar">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
        Criar Solicitação
      </button>
    </div>
  </div>

  <div class="card">
    <h3 class="card-title">Monitoramento de Demandas</h3>
    <div class="table-responsive">
      <table>
        <thead>
          <tr>
            <th>Criação</th><th>Divisão</th><th>Marca</th><th>Campanha</th><th>Tipo</th>
            <th>Solicitante</th><th>Responsável</th><th>Motivo Ajuste</th><th>Status</th><th>Ações</th>
          </tr>
        </thead>
        <tbody id="corpoAndamento"><tr><td colspan="10" style="text-align:center;">Carregando...</td></tr></tbody>
      </table>
    </div>
  </div>

  <div class="card">
    <h3 class="card-title">Histórico (Últimas 50)</h3>
    <div class="table-responsive">
      <table>
        <thead>
          <tr>
            <th>Criação</th><th>Conclusão</th><th>Divisão</th><th>Marca</th><th>Campanha</th>
            <th>Solicitante</th><th>Responsável</th><th>Motivo Ajuste</th><th>Status</th><th>Ações</th>
          </tr>
        </thead>
        <tbody id="corpoConcluidas"><tr><td colspan="10" style="text-align:center;">Carregando...</td></tr></tbody>
      </table>
    </div>
  </div>

  <div id="modalEdicao" class="fundo-escuro">
    <div class="janela-modal">
      <h3>Detalhes da Demanda</h3>
      <input type="hidden" id="edit_linha">
      <div class="modal-grid">
        <div class="input-group"><label>Data de Criação</label><input type="text" id="edit_data" class="campo-leitura" readonly></div>
        <div class="input-group"><label>Solicitante</label><input type="text" id="edit_solicitante" class="campo-leitura" readonly></div>
        <div class="input-group"><label>Responsável</label><input type="text" id="edit_responsavel"></div>
        <div class="input-group"><label>Divisão</label><select id="edit_divisao"><option value=""></option><option value="DL">DL</option><option value="DPGP">DPGP</option><option value="DPP">DPP</option><option value="LBD">LBD</option><option value="CORP">CORP</option></select></div>
        <div class="input-group"><label>Marca</label><input type="text" id="edit_marca"></div>
        <div class="input-group"><label>Campanha</label><input type="text" id="edit_campanha"></div>
        <div class="input-group"><label>Tipo de Demanda</label><select id="edit_tipoDemanda"><option value=""></option><option value="Atualizar PM">Atualizar PM</option><option value="Atualizar base">Atualizar base</option><option value="Ajuste Dash">Ajuste Dash</option><option value="Ajuste PV">Ajuste PV</option><option value="Automatização">Automatização</option><option value="Novo PM">Novo PM</option><option value="RM - add dicionario">RM - add dicionario</option><option value="RM dando erro">RM dando erro</option></select></div>
        <div class="input-group">
          <label>Motivo do Ajuste</label>
          <select id="edit_motivo">
            <option value=""></option><option value="nah">nah</option><option value="falso-positivo">falso-positivo</option><option value="erro preenchimento plano">erro preenchimento plano</option><option value="erro preenchimento output">erro preenchimento output</option><option value="erro preenchimento base manual">erro preenchimento base manual</option><option value="diferença output/plano">diferença output/plano</option><option value="faltou envio PM">faltou envio PM</option><option value="reprocessamento">reprocessamento</option><option value="sem código hash">sem código hash</option><option value="hash duplicado">hash duplicado</option><option value="hash trocado">hash trocado</option><option value="Erro de preenchimento planilha de alcance">Erro de preenchimento planilha de alcance</option><option value="Erro na formula planilha de alcance">Erro na formula planilha de alcance</option><option value="Plano desatualizado">Plano desatualizado</option><option value="Data Geeks">Data Geeks</option><option value="Ajuste dash">Ajuste dash</option><option value="outros (especificar ao lado)">outros (especificar ao lado)</option>
          </select>
        </div>
        <div class="input-group">
          <label>Status</label>
          <select id="edit_status">
            <option value="não iniciado">não iniciado</option><option value="fazendo">fazendo</option><option value="aguardando resposta">aguardando resposta</option><option value="concluído">concluído</option><option value="cancelado">cancelado</option><option value="briefing incompleto">briefing incompleto</option>
          </select>
        </div>
        <div class="input-group modal-col-full"><label>Link Associado</label><input type="text" id="edit_link"></div>
        <div class="input-group modal-col-full"><label>Observação Original</label><input type="text" id="edit_observacao"></div>
        <div class="input-group modal-col-full"><label>Detalhamento da Execução</label><input type="text" id="edit_detalhamento"></div>
      </div>
      <div class="btn-container">
        <button class="btn btn-cancelar" onclick="fecharModal()">Fechar</button>
        <button class="btn btn-sucesso" onclick="salvarEdicao()" id="btnSalvarModal">Salvar Alterações</button>
      </div>
    </div>
  </div>

  <script>
    const svgEye = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>`;
    const svgEdit = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>`;
    const svgLink = `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>`;

    var dadosGlobais = [];
    var historicoExpandido = false; 

    window.onload = carregarDados;
    setInterval(carregarDados, 10000);

    function atualizarContador() {
      let obs = document.getElementById("novo_observacao").value;
      document.getElementById("charCount").innerText = obs.length + "/300";
    }

    function toggleHistorico() {
      historicoExpandido = !historicoExpandido;
      let linhasOcultas = document.querySelectorAll('.linha-extra-historico');
      linhasOcultas.forEach(linha => {
        linha.style.display = historicoExpandido ? 'table-row' : 'none';
      });
      let btnSeta = document.getElementById('btnSetaHistorico');
      if (btnSeta) {
        btnSeta.innerHTML = historicoExpandido ? '&#9650; Ver Menos' : '&#9660; Ver Mais ' + linhasOcultas.length + ' tarefas no histórico';
      }
    }

    function carregarDados() {
      // CORREÇÃO: Adicionado tratamento de erro visual. Se o servidor falhar, mostrará o motivo na tela.
      google.script.run
        .withSuccessHandler(montarTabelas)
        .withFailureHandler(function(erro) {
            document.getElementById("corpoAndamento").innerHTML = `<tr><td colspan='10' style='color:red; text-align:center;'><b>Erro no Servidor:</b> ${erro.message}<br>Verifique se os cabeçalhos da planilha estão corretos.</td></tr>`;
        })
        .buscarDados();
    }

    function montarTabelas(dadosArray) {
      if (!dadosArray || !Array.isArray(dadosArray)) return;
      
      dadosGlobais = dadosArray; 
      let tbodyAndamento = document.getElementById("corpoAndamento");
      let tbodyConcluidas = document.getElementById("corpoConcluidas");
      let htmlAndamento = "";
      let htmlConcluidas = "";
      
      let tarefasAtivas = [];
      let tarefasConcluidas = [];

      dadosArray.forEach((linha) => {
        if (linha[8] === "concluído" || linha[8] === "cancelado") {
          tarefasConcluidas.push(linha);
        } else {
          tarefasAtivas.push(linha);
        }
      });

      tarefasConcluidas.reverse();

      tarefasAtivas.forEach((linha) => {
        let status = linha[8]; 
        let numeroLinhaSheets = linha[13]; 

        // Proteção contra quebras caso o valor venha como número puro da folha Excel
        let dataVisual = linha[0] ? String(linha[0]) : '';
        if (dataVisual.includes("-")) {
           let p = dataVisual.split("-");
           if (p.length === 3) dataVisual = `${p[2]}/${p[1]}/${p[0].substring(2)}`; 
        }

        let badgeClass = "badge-nao-iniciado"; 
        if (status === "fazendo") badgeClass = "badge-fazendo";
        else if (status === "aguardando resposta") badgeClass = "badge-aguardando";
        else if (status === "briefing incompleto") badgeClass = "badge-briefing";
        
        let statusHtml = `<span class="badge ${badgeClass}">${status || 'não iniciado'}</span>`;
        
        let linkStr = linha[6] ? String(linha[6]).trim() : "";
        let botaoLink = (linkStr !== "") ? 
          `<a href="${linkStr}" target="_blank" class="btn-link-tabela">${svgLink} Acessar Link</a>` : 
          `<span class="btn-link-tabela btn-link-disabled">${svgLink} Acessar Link</span>`;

        htmlAndamento += `
          <tr>
            <td>${dataVisual}</td>
            <td class="td-curta">${linha[1] || ''}</td>
            <td class="td-curta">${linha[2] || ''}</td>
            <td class="td-curta" title="${linha[3] || ''}">${linha[3] || ''}</td>
            <td class="td-curta">${linha[4] || ''}</td>
            <td class="td-curta">${linha[5] || ''}</td>
            <td class="td-curta">${linha[7] || ''}</td>
            <td class="td-curta">${linha[11] || ''}</td>
            <td>${statusHtml}</td>
            <td>
              <div class="acoes-container">
                <span class="icon-action" title="Ver Detalhes" onclick="abrirModal(${numeroLinhaSheets})">${svgEye}</span>
                <span class="icon-action" title="Editar" onclick="abrirModal(${numeroLinhaSheets})">${svgEdit}</span>
                ${botaoLink}
              </div>
            </td>
          </tr>`;
      });

      let limiteConcluidas = 0; 
      
      tarefasConcluidas.forEach((linha) => {
        if (limiteConcluidas >= 50) return; 
        
        let status = linha[8]; 
        let numeroLinhaSheets = linha[13]; 

        let dataVisual = linha[0] ? String(linha[0]) : '';
        if (dataVisual.includes("-")) { 
            let p = dataVisual.split("-"); 
            if(p.length === 3) dataVisual = `${p[2]}/${p[1]}/${p[0].substring(2)}`; 
        }

        let dataConclusaoVisual = linha[9] ? String(linha[9]) : '-';
        if (dataConclusaoVisual !== '-' && dataConclusaoVisual.includes("-")) { 
            let p = dataConclusaoVisual.split("-"); 
            if(p.length === 3) dataConclusaoVisual = `${p[2]}/${p[1]}/${p[0].substring(2)}`; 
        }

        let badgeClass = (status === "cancelado") ? "badge-cancelado" : "badge-concluido";
        let statusHtml = `<span class="badge ${badgeClass}">${status}</span>`;
        
        let linkStr = linha[6] ? String(linha[6]).trim() : "";
        let botaoLink = (linkStr !== "") ? 
          `<a href="${linkStr}" target="_blank" class="btn-link-tabela">${svgLink} Acessar Link</a>` : 
          `<span class="btn-link-tabela btn-link-disabled">${svgLink} Acessar Link</span>`;

        let classeOculta = (limiteConcluidas >= 10) ? "linha-extra-historico" : "";
        let estiloOculto = (limiteConcluidas >= 10 && !historicoExpandido) ? 'style="display: none;"' : '';

        htmlConcluidas += `
          <tr class="${classeOculta}" ${estiloOculto}>
            <td>${dataVisual}</td>
            <td><strong>${dataConclusaoVisual}</strong></td>
            <td class="td-curta">${linha[1] || ''}</td>
            <td class="td-curta">${linha[2] || ''}</td>
            <td class="td-curta" title="${linha[3] || ''}">${linha[3] || ''}</td>
            <td class="td-curta">${linha[5] || ''}</td>
            <td class="td-curta">${linha[7] || ''}</td>
            <td class="td-curta">${linha[11] || ''}</td>
            <td>${statusHtml}</td>
            <td>
              <div class="acoes-container">
                <span class="icon-action" title="Ver Detalhes" onclick="abrirModal(${numeroLinhaSheets})">${svgEye}</span>
                ${botaoLink}
              </div>
            </td>
          </tr>`;
        
        limiteConcluidas++;
      });

      if (limiteConcluidas > 10) {
        let textoBotao = historicoExpandido ? '&#9650; Ver Menos' : '&#9660; Ver Mais ' + (limiteConcluidas - 10) + ' tarefas no histórico';
        htmlConcluidas += `
          <tr class="btn-expandir-historico" onclick="toggleHistorico()">
            <td colspan="10" id="btnSetaHistorico" style="padding: 12px;">${textoBotao}</td>
          </tr>
        `;
      }

      tbodyAndamento.innerHTML = htmlAndamento || "<tr><td colspan='10' style='text-align:center; padding:15px;'>Nenhuma demanda ativa.</td></tr>";
      tbodyConcluidas.innerHTML = htmlConcluidas || "<tr><td colspan='10' style='text-align:center; padding:15px;'>Nenhum histórico disponível.</td></tr>";
    }

    function abrirModal(numeroLinhaSheets) {
      let linha = dadosGlobais.find(l => l[13] === numeroLinhaSheets);
      if(linha) {
        document.getElementById("edit_linha").value = numeroLinhaSheets;
        document.getElementById("edit_data").value = linha[0];
        document.getElementById("edit_divisao").value = linha[1];
        document.getElementById("edit_marca").value = linha[2];
        document.getElementById("edit_campanha").value = linha[3];
        document.getElementById("edit_tipoDemanda").value = linha[4];
        document.getElementById("edit_link").value = linha[6];
        document.getElementById("edit_observacao").value = linha[10];
        document.getElementById("edit_solicitante").value = linha[5];
        document.getElementById("edit_responsavel").value = linha[7];
        document.getElementById("edit_status").value = linha[8];
        document.getElementById("edit_motivo").value = linha[11];
        document.getElementById("edit_detalhamento").value = linha[12];

        if(linha[8] === "concluído" || linha[8] === "cancelado") {
            document.getElementById("btnSalvarModal").style.display = "none";
        } else {
            document.getElementById("btnSalvarModal").style.display = "inline-flex";
        }
        document.getElementById("modalEdicao").style.display = "block";
      }
    }

    function fecharModal() { document.getElementById("modalEdicao").style.display = "none"; document.getElementById("edit_linha").value = ""; }

    function criarSolicitacao() {
      let btn = document.getElementById("btnCriar");
      btn.innerHTML = "Salvando..."; btn.disabled = true;
      let dadosNovos = {
        divisao: document.getElementById("novo_divisao").value,
        marca: document.getElementById("novo_marca").value,
        campanha: document.getElementById("novo_campanha").value,
        tipoDemanda: document.getElementById("novo_tipoDemanda").value,
        link: document.getElementById("novo_link").value,
        observacao: document.getElementById("novo_observacao").value
      };
      google.script.run.withSuccessHandler(function() {
        btn.innerHTML = `${svgEdit} Criar Solicitação`; btn.disabled = false;
        document.getElementById("novo_divisao").value = "";
        document.getElementById("novo_marca").value = "";
        document.getElementById("novo_campanha").value = "";
        document.getElementById("novo_tipoDemanda").value = "";
        document.getElementById("novo_link").value = "";
        document.getElementById("novo_observacao").value = "";
        atualizarContador();
        carregarDados(); 
      }).salvarNaPlanilha(dadosNovos);
    }

    function salvarEdicao() {
      let btn = document.getElementById("btnSalvarModal");
      btn.innerHTML = "Atualizando..."; btn.disabled = true;
      let dadosAtualizados = {
        dataOriginal: document.getElementById("edit_data").value,
        solicitanteOriginal: document.getElementById("edit_solicitante").value,
        divisao: document.getElementById("edit_divisao").value,
        marca: document.getElementById("edit_marca").value,
        campanha: document.getElementById("edit_campanha").value,
        tipoDemanda: document.getElementById("edit_tipoDemanda").value,
        link: document.getElementById("edit_link").value,
        observacao: document.getElementById("edit_observacao").value,
        responsavel: document.getElementById("edit_responsavel").value,
        status: document.getElementById("edit_status").value,
        motivoAjuste: document.getElementById("edit_motivo").value,
        detalhamento: document.getElementById("edit_detalhamento").value
      };
      
      let linhaEditando = document.getElementById("edit_linha").value;
      google.script.run.withSuccessHandler(function() {
        btn.innerHTML = "Salvar Alterações"; btn.disabled = false;
        fecharModal();
        carregarDados();
      }).atualizarNaPlanilha(dadosAtualizados, parseInt(linhaEditando));
    }
  </script>
