// Substitua pelo ID que está no link da planilha (entre /d/ e /edit)
var ID_PLANILHA = "id"; 

// Substitua pelo nome exato da aba onde os dados serão salvos
var NOME_ABA = "NOME_DA_SUA_ABA"; 

function doGet() {
  var html = HtmlService.createHtmlOutputFromFile('index');
  html.setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
  return html;
}

function buscarDados() {
  var planilha = SpreadsheetApp.openById(ID_PLANILHA).getSheetByName(NOME_ABA);
  var dados = planilha.getDataRange().getValues();
  var dadosLimpos = [];
  
  for (var i = 1; i < dados.length; i++) {
    var linha = dados[i];
    if (linha.join("").trim() === "") continue;
    
    // CORREÇÃO CRÍTICA: Varre a linha inteira à procura de objetos do tipo Date
    // Isso impede que datas acidentais noutras colunas bloqueiem a comunicação.
    for (var col = 0; col < linha.length; col++) {
      if (linha[col] instanceof Date) {
        linha[col] = Utilities.formatDate(linha[col], Session.getScriptTimeZone(), "yyyy-MM-dd");
      }
    }
    
    linha.push(i + 1); 
    dadosLimpos.push(linha);
  }
  return dadosLimpos;
}

function salvarNaPlanilha(dados) {
  var lock = LockService.getScriptLock();
  try {
    lock.waitLock(10000);
    var planilha = SpreadsheetApp.openById(ID_PLANILHA).getSheetByName(NOME_ABA);
    var dataAtual = new Date();
    var email = Session.getActiveUser().getEmail();
    var nomeSolicitante = "Usuário Desconhecido";
    
    if (email) {
      var partesNome = email.split('@')[0].split('.');
      nomeSolicitante = partesNome.map(function(palavra) {
        return palavra.charAt(0).toUpperCase() + palavra.slice(1);
      }).join(' ');
    }

    planilha.appendRow([
      dataAtual, dados.divisao, dados.marca, dados.campanha, dados.tipoDemanda, nomeSolicitante,
      dados.link, "", "não iniciado", "", dados.observacao, "", ""
    ]);
    planilha.appendRow(Array(13).fill(""));
    
    SpreadsheetApp.flush();
    return true;
  } catch (e) { return false; } finally { lock.releaseLock(); }
}

function atualizarNaPlanilha(dados, numeroLinha) {
  var lock = LockService.getScriptLock();
  try {
    lock.waitLock(10000);
    var planilha = SpreadsheetApp.openById(ID_PLANILHA).getSheetByName(NOME_ABA);
    var intervalo = planilha.getRange(numeroLinha, 1, 1, 13);
    var linhaAtual = intervalo.getValues()[0];
    var dataConclusaoSalva = linhaAtual[9]; 
    
    var statusFinalizado = (dados.status === "concluído" || dados.status === "cancelado");
    
    if (statusFinalizado && (!dataConclusaoSalva || dataConclusaoSalva === "")) {
       dataConclusaoSalva = new Date(); 
    } else if (!statusFinalizado) {
       dataConclusaoSalva = ""; 
    }

    intervalo.setValues([[
      dados.dataOriginal, dados.divisao, dados.marca, dados.campanha, dados.tipoDemanda, dados.solicitanteOriginal,
      dados.link, dados.responsavel, dados.status, dataConclusaoSalva, dados.observacao, dados.motivoAjuste, dados.detalhamento
    ]]);
    
    SpreadsheetApp.flush();
    return true;
  } catch (e) { return false; } finally { lock.releaseLock(); }
}
